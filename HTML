        const itemsGrid = document.getElementById('itemsGrid');
        fusimidoItems.forEach(item => {
            const card = document.createElement('div');
            card.className = 'item-card';
            card.innerHTML = `
                <img src="${item.img}" class="item-img" alt="${item.title}" loading="lazy">
                <div class="item-info">
                    <h4>${item.title}</h4>
                    <div class="spec">${item.spec}</div>
                    <p>${item.desc}</p>
                </div>
            `;
            card.addEventListener('click', () => openModal(item));
            itemsGrid.appendChild(card);
        });

        const modalOverlay = document.getElementById('modalOverlay');
        function openModal(item) {
            document.getElementById('modalImg').src = item.img;
            document.getElementById('modalTitle').innerText = item.title;
            document.getElementById('modalSpec').innerText = item.spec;
            document.getElementById('modalDesc').innerText = item.desc;
            modalOverlay.classList.add('active');
        }
        document.getElementById('modalClose').addEventListener('click', () => modalOverlay.classList.remove('active'));
        modalOverlay.addEventListener('click', (e) => { if (e.target === modalOverlay) modalOverlay.classList.remove('active'); });

        let animated = false;
        window.addEventListener('scroll', () => {
            const statsSec = document.querySelector('.stats-wrap');
            if (statsSec.getBoundingClientRect().top < window.innerHeight - 80 && !animated) {
                animated = true;
                document.querySelectorAll('.num').forEach(counter => {
                    const target = +counter.getAttribute('data-target');
                    let count = 0;
                    const speed = target / 40;
                    const update = () => {
                        count += speed;
                        if (count < target) {
                            counter.childNodes[0].nodeValue = Math.ceil(count);
                            setTimeout(update, 30);
                        } else {
                            counter.childNodes[0].nodeValue = target;
                        }
                    };
                    update();
                });
            }
        });
    </script>
